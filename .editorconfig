root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.html]
# IntelliJ reads ij_* properties; other editors ignore them. Keep wrapped attributes
# at one continuation indent so the IDE matches html/indent in eslint.config.js.
ij_html_align_attributes = false
ij_continuation_indent_size = 2

[Makefile]
indent_style = tab
